{
    "modules": [
        "zsa/navigator_trackball",
        "zsa/navigator_trackpad",
        "zsa/automouse",
        "zsa/defaults",
        "zsa/mousejiggler"
    ],
    "config": {
        "build": {
            "debounce_type": "asym_eager_defer_pk",
            "firmware_format": "bin",
            "lto": true
        },
        "debounce": 7,
        "tapping": {
            "term": 293,
            "term_per_key": true,
            "flow_tap_term": 199
        },
        "host": { 
            "default": { 
                "nkro": true
            } 
        },
        "usb": {
            "max_power": 400,
            "no_startup_check": false,
            "polling_interval": 1,
            "suspend_wakeup_delay": 199,
            "wait_for_enumeration": true
        },
        "eeprom": {
            "driver": "transient"
        },
        "features": {
            "caps_word": true,
            "deferred_exec": true,
            "extrakey": true,
            "mousekey": true,
            "nkro": true,
            "rgb_matrix": true,
            "swap_hands": true,

            "bootmagic": false,
            "grave_esc": false,
            "key_override": false,
            "magic": false,
            "space_cadet": false,
            "tap_dance": false,
            
            "backlight": false,
            "rgb_light": false,
            "led_matrix": false
        },
        "caps_word": {
            "enabled": true,
            "both_shifts_turns_on": true,
            "double_tap_shift_turns_on": true
        },
        "rgb_matrix": {
            "sleep": false,
            "timeout": 0,
            "default": {
                "on": false,
                "hue": 0,
                "sat": 0,
                "val": 0,
                "speed": 0
            },
            "animations": {
                "alphas_mods": false,
                "gradient_up_down": false,
                "gradient_left_right": false,
                "breathing": true,
                "band_sat": false,
                "band_val": false,
                "band_pinwheel_sat": false,
                "band_pinwheel_val": false,
                "band_spiral_sat": false,
                "band_spiral_val": false,
                "cycle_all": false,
                "cycle_left_right": true,
                "cycle_up_down": false,
                "rainbow_moving_chevron": false,
                "cycle_out_in": false,
                "cycle_out_in_dual": false,
                "cycle_pinwheel": false,
                "cycle_spiral": false,
                "dual_beacon": false,
                "rainbow_beacon": false,
                "rainbow_pinwheels": false,
                "flower_blooming": true,
                "raindrops": false,
                "jellybean_raindrops": false,
                "hue_breathing": false,
                "hue_pendulum": false,
                "hue_wave": false,
                "pixel_rain": false,
                "pixel_flow": false,
                "pixel_fractal": false,
                "typing_heatmap": false,
                "digital_rain": false,
                "solid_reactive_simple": false,
                "solid_reactive": false,
                "solid_reactive_wide": false,
                "solid_reactive_multiwide": false,
                "solid_reactive_cross": false,
                "solid_reactive_multicross": false,
                "solid_reactive_nexus": false,
                "solid_reactive_multinexus": false,
                "splash": false,
                "multisplash": false,
                "solid_splash": false,
                "solid_multisplash": false,
                "starlight": false,
                "starlight_dual_hue": false,
                "starlight_dual_sat": false,
                "riverflow": false
            }
        }
    }
}
