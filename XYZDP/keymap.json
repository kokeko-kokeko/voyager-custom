{
    "modules": [
        "zsa/navigator_trackball",
        "zsa/navigator_trackpad",
        "zsa/automouse",
        "zsa/defaults",
        "zsa/mousejiggler"
    ],
    "features": {
        "nkro": true
    },
    "config": {
        "debounce": 7,
        "build": {
            "debounce_type": "asym_eager_defer_pk"
        },
        "host": { 
            "default": { 
                "nkro": true
            } 
        },
        "usb": {
            "polling_interval": 1,
            "suspend_wakeup_delay": 199
        },
        "tapping": {
            "term_per_key": true,
            "term": 293,
            "flow_tap_term" : 199
        },
        "eeprom": {
            "driver": "transient"
        },
        "bootmagic": {
            "enabled": false
        },
        "caps_word": {
            "enabled": true
        },
        "mouse_key": {
            "enabled": true
        },        
        "rgb_matrix": {
            "sleep": false,
            "timeout": 0
        }
    }

}
